# ---- Supabase (Project settings > API). Service role key: server-side only. ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram: create a bot with @BotFather; get your chat id from @userinfobot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Jev (TypeSafe AI). Leave empty to use the offline keyword rules instead. ----
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# Answers below this confidence count as "unknown".
JEV_MIN_CONFIDENCE=0.6

# ---- Money ----
# Colones per US dollar, used to convert USD listings. Update now and then.
USD_CRC_RATE=505

# ---- Politeness / health ----
REQUEST_DELAY_SECONDS=4
HEALTH_EMPTY_RUNS=3

# Link to the review dashboard, used in the daily digest.
DASHBOARD_URL=https://your-dashboard.vercel.app

# ---- Optional: your own pre-filtered, newest-first search URLs (space separated) ----
# HUNTER_URLS_ENCUENTRA24=
# HUNTER_URLS_CASAS24=
# HUNTER_URLS_ANUNTICO=
# HUNTER_URLS_INHAUSCR=
# HUNTER_URLS_ALQUILACR=
